{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tingle.world/schemas/word-image-manifest-v1.json",
  "title": "Tingle word-image manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "contentVersion",
    "coreWordCount",
    "imageStrategy",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "coreWordCount": {
      "const": 2000
    },
    "imageStrategy": {
      "const": "neutral-sketch-with-app-color-overlay"
    },
    "cardSpecification": {
      "type": "object"
    },
    "thumbnailSpecification": {
      "type": "object"
    },
    "records": {
      "type": "array",
      "minItems": 2000,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "wordId",
          "headword",
          "rank",
          "pack",
          "status",
          "alt",
          "cardPath",
          "thumbnailPath",
          "expectedCardPath",
          "expectedThumbnailPath",
          "checksumSha256",
          "updatedAt"
        ],
        "properties": {
          "wordId": {
            "type": "string",
            "pattern": "^TNG-[0-9]{4}$"
          },
          "headword": {
            "type": "string",
            "minLength": 1
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "pack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "status": {
            "enum": [
              "not_started",
              "draft",
              "in_review",
              "approved",
              "retired"
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "cardPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "thumbnailPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "expectedCardPath": {
            "type": "string"
          },
          "expectedThumbnailPath": {
            "type": "string"
          },
          "checksumSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
